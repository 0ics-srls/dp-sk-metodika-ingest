{
  "specVersion": "1.1",
  "type": "stdin",
  "name": "dp-sk-metodika-ingest",
  "version": "0.1.0",
  "description": "Loads the plan files of the Slovak guidance package (documents, passages, skipped items, coverage) into the dataset schema, one transaction per item. Keeps embeddings of unchanged documents.",
  "author": "open-lex-it",
  "authentication": false,
  "actions": {
    "execute": {
      "description": "For each item read its plan file under dirIn and write it to the dataset in one transaction. An item that fails rolls back alone. With dryRun the transaction is always rolled back.",
      "input": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "description": "the items to load, as reported by the detect step",
            "items": {
              "type": "object",
              "properties": {
                "key": { "type": "string", "minLength": 1 },
                "meta": { "type": "object", "properties": { "kind": { "enum": ["fs", "pdf"] }, "itemId": { "type": "string" } }, "required": ["kind", "itemId"] }
              },
              "required": ["key", "meta"]
            }
          },
          "dirIn": { "type": "string", "description": "directory with the plan files" },
          "connString": { "type": "string", "x-secret": true, "description": "dataset connection string" },
          "schema": { "type": "string", "pattern": "^ds_[a-z0-9_]+$", "description": "dataset schema" },
          "dryRun": { "type": ["boolean", "null"], "description": "write inside the transaction, report the counts, then roll back" }
        },
        "required": ["items", "dirIn", "connString", "schema"]
      },
      "output": {
        "type": "object",
        "description": "{ loaded: [key], metrics: {written.<schema.table>, items, skipped_documents, warnings} }"
      }
    },
    "terminate": {
      "description": "Stop and clean up.",
      "input": { "type": "object", "properties": {} }
    }
  },
  "execution": {
    "timeout": 3600,
    "memoryLimit": "512Mi",
    "cpuLimit": "1.0"
  }
}
